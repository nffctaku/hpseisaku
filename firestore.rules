rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // clubId のデータ領域に対する書き込み権限:
    // - 旧形式: clubId == 認証uid
    // - Career形式: club_profiles/{clubId}.ownerUid == 認証uid
    function isClubOwner(clubId) {
      return request.auth != null
        && (
          request.auth.uid == clubId
          || (
            exists(/databases/$(database)/documents/club_profiles/$(clubId))
            && get(/databases/$(database)/documents/club_profiles/$(clubId)).data.ownerUid == request.auth.uid
          )
        );
    }

    // CLUB PROFILES - Allow read for authenticated users, write for owners
    match /club_profiles/{userId} {
      allow read: if request.auth != null;
      // Allow writes when:
      // - document id equals the authenticated uid (legacy pattern)
      // - OR the document's ownerUid equals the authenticated uid (current pattern)
      // - OR the incoming write sets ownerUid to the authenticated uid (create/merge)
      allow write: if request.auth != null
        && (
          request.auth.uid == userId
          || resource.data.ownerUid == request.auth.uid
          || request.resource.data.ownerUid == request.auth.uid
        );
    }

    // USER-SPECIFIC DATA - Full access for owners
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ANALYTICS EVENTS
    match /analyticsEvents/{eventId} {
      allow create: if
        (request.auth != null && request.resource.data.userId == request.auth.uid)
        || (request.auth == null
            && request.resource.data.userId == null
            && request.resource.data.eventName in ['sample_view', 'signup_cta_click']);
      allow read, update, delete: if false;
    }

    // 利用規約同意状態（本人のみ）
    match /user_consents/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // CAREERS - ownerのみ読み書き可能（旧形式 careers/{ownerId} も許可）
    match /careers/{careerId} {
      allow read: if request.auth != null
        && (careerId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow write: if request.auth != null
        && (
          careerId == request.auth.uid
          || resource.data.ownerId == request.auth.uid
          || request.resource.data.ownerId == request.auth.uid
        );
    }

    // CLUB DATA - Allow read for authenticated users, write for club owners
    match /clubs/{clubId} {
      // Allow read access for authenticated users
      allow read: if request.auth != null;
      
      // Club metadata - write only for club owners
      allow write: if isClubOwner(clubId);

      // Team categories
      match /team_categories/{categoryId} {
        allow read: if request.auth != null;
        allow write: if isClubOwner(clubId);
      }
      
      // Competitions
      match /competitions/{competitionId} {
        allow read: if request.auth != null;
        allow write: if isClubOwner(clubId);

        // Competition settings (templates etc.)
        match /settings/{settingId} {
          allow read: if request.auth != null;
          allow write: if isClubOwner(clubId);
        }

        // Standings
        match /standings/{teamId} {
          allow read: if request.auth != null;
          allow write: if isClubOwner(clubId);
        }
        
        // Competition rounds and matches
        match /rounds/{roundId} {
          allow read: if request.auth != null;
          allow write: if isClubOwner(clubId);
          
          match /matches/{matchId} {
            allow read: if request.auth != null;
            allow write: if isClubOwner(clubId);

            // Match events
            match /events/{eventId} {
              allow read: if request.auth != null;
              allow write: if isClubOwner(clubId);
            }
          }
        }
      }
      
      // Teams and players
      match /teams/{teamId} {
        allow read: if request.auth != null;
        allow write: if isClubOwner(clubId);
        
        match /players/{playerId} {
          allow read: if request.auth != null;
          allow write: if isClubOwner(clubId);
        }

        // Transfers
        match /transfers/{transferId} {
          allow read: if request.auth != null;
          allow write: if isClubOwner(clubId);
        }

        // Staff
        match /staff/{staffId} {
          allow read: if request.auth != null;
          allow write: if isClubOwner(clubId);
        }
      }
      
      // Seasons and roster
      match /seasons/{seasonId} {
        allow read: if request.auth != null;
        allow write: if isClubOwner(clubId);
        
        match /roster/{playerId} {
          allow read: if request.auth != null;
          allow write: if isClubOwner(clubId);
        }
      }

      // News
      match /news/{newsId} {
        allow read: if request.auth != null;
        allow write: if isClubOwner(clubId);
      }

      // Videos
      match /videos/{videoId} {
        allow read: if request.auth != null;
        allow write: if isClubOwner(clubId);
      }
      
      // Friendly matches
      match /friendly_matches/{matchId} {
        allow read: if request.auth != null;
        allow write: if isClubOwner(clubId);
      }

      // Public match index (for fast match listing/search)
      match /public_match_index/{indexId} {
        allow read: if request.auth != null;
        allow write: if isClubOwner(clubId);
      }

      // Legacy matches collection
      match /matches/{matchId} {
        allow read: if request.auth != null;
        allow write: if isClubOwner(clubId);

        match /events/{eventId} {
          allow read: if request.auth != null;
          allow write: if isClubOwner(clubId);
        }
      }
      
      // Public player stats cache
      match /public_player_stats_cache/{playerId} {
        allow read: if request.auth != null;
        allow write: if isClubOwner(clubId);
      }

      match /{document=**} {
        allow read: if request.auth != null;
        allow write: if isClubOwner(clubId);
      }
    }

    // Global collections (if any)
    match /matches/{matchId} {
      allow read: if request.auth != null;
      allow write: if false; // No writes to global matches
    }
  }
}
