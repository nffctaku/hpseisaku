# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
**/node_modules
node_modules_old/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-*/
/out/

# local verification / diagnostics (not for commit)
/.tmp/
/.tmp-verify-build/
/screenshots/
/tsc_errors.txt
/tsconfig.verify.json
/repair-proposal.md
/PHASE2_REPORT.md

# emulator & debug artifacts
*.log
.firebase/
/emulator-data/
/nul

# local-only scripts (diagnostics, one-off verify, prod-data repair)
/scripts/*
!/scripts/start-dev.cjs

# emulator-only test login page (not for production repo)
/src/app/admin/test-login/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
